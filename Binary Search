Rotate Array
class Solution {
    public void rotate(int[] nums, int k) {
      int n=nums.length;
      k=k%n;
      int[] temp=new int[n];
      for(int i=0;i<n;i++){
         int news=(i+k)%n;
         temp[news]=nums[i];
      }
      for(int i=0;i<nums.length;i++){
        nums[i]=temp[i];
      }
    }
}

Find first and last position element of sorted array
class Solution {
    public int[] searchRange(int[] nums, int target) {
        int first=findFirst(nums,target);
        int second=findLast(nums,target);
        return new int[]{first,second};
    }

    private int findFirst(int[] nums,int target){
        int low=0;int rigth=nums.length-1;
        int ans=-1;
        while(low<=rigth){
            int mid=low+(rigth-low)/2;
            if(nums[mid]==target){
               ans=mid;
                rigth=mid-1;
            }
            else if(nums[mid]<=target){
                    low=mid+1;
            }else{
                    rigth=mid-1;
            }

        }
        return ans;
    }
    private int findLast(int[] nums,int target){
        int low=0;int rigth=nums.length-1;
        int ans=-1;
        while(low<=rigth){
            int mid=low+(rigth-low)/2;
            if(nums[mid]==target){
                ans=mid;
                low=mid+1;
            }
            else if(nums[mid]<=target){
                    low=mid+1;
            }else{
                    rigth=mid-1;
            }

        }
        return ans;
    }
}


search in rotate sorted array:
class Solution {
    public int search(int[] nums, int target) {
        int low=0;
        int rigth=nums.length-1;
        while(low<=rigth){
            int mid=low+(rigth-low)/2;

            if(nums[mid]==target) return mid;

            if(nums[mid]>=nums[low]){
                if(nums[low]<=target && target<nums[mid]){rigth=mid-1;}else{low=mid+1;}
            } else{
                if(nums[mid]<target && target<=nums[rigth]){low=mid+1;}else{rigth=mid-1;}
            } 
        }return -1;
    }
}

Squrt(x):

class Solution {
    public int mySqrt(int x) {if(x<2) return x;
        long low=0,right=x/2;
        while(low<=right){
            long mid=low+(right-low)/2;
            long square=mid*mid;
            if(square==x) return (int) mid;

            if(square<x) {low=mid+1;}else{right=mid-1;}
        }return (int) right;

    }
}

