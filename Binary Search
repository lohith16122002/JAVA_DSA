Trapping rain water
class Solution {
    public int trap(int[] height) {
        int n = height.length;

        int[] leftMax = new int[n];
        int[] rightMax = new int[n];

        leftMax[0] = height[0];
        for (int i = 1; i < n; i++) {
            leftMax[i] = Math.max(leftMax[i - 1], height[i]);
        }

        rightMax[n - 1] = height[n - 1];
        for (int i = n - 2; i >= 0; i--) {
            rightMax[i] = Math.max(rightMax[i + 1], height[i]);
        }

        int water = 0;
        for (int i = 0; i < n; i++) {
            water += Math.min(leftMax[i], rightMax[i]) - height[i];
        }

        return water;
    }
}

Find peak element:
class Solution {
    public int findPeakElement(int[] nums) {
        int low=0;
        int high=nums.length-1;
        while(low<high){
            int mid=low+(high-low)/2;
            if(nums[mid]>nums[mid+1]){
                high=mid;
            }else{
                low=mid+1;
            }
            
        }return low;
    }
}



Magnetic Force Between Two Balls
class Solution {
    public int maxDistance(int[] position, int m) {
        Arrays.sort(position);
        int n =position.length;
        int low=1,right=position[n-1]-position[0];
        int ans=0;
        while(low<=right){
            int mid=low+(right-low)/2;
            if(maxs(position,m,mid)){
                ans=mid;
                low=mid+1;
            }else{
                right=mid-1;
            }
        }return ans;
    }
    private boolean maxs(int[] position,int m,int dist){
        int count=1;
        int last=position[0];
        for(int i=0;i<position.length;i++){
        if(position[i]-last>=dist){
            last=position[i];
            count++;
        }
        if(count>=m) return true;
    }
    return false;
}
}


Minimum Number of Days to Make m Bouquets
class Solution {
    public int minDays(int[] bloomDay, int m, int k) {
if((long)m*k>bloomDay.length) return -1;

int min=Integer.MAX_VALUE;
int max=Integer.MIN_VALUE:
for(int bloom:bloomDay){
min=Math.min(min,bloom);
max=Math.max(max,bloom);
}
for(int i=min;i<max;i++){
if(daysss(bloomDay,m,k,i)){
return i;}}return -1;}

private boolean daysss(int[] bloomDay,int m,int k,int day){
int count=0,bouquets=0;
while(int da:bloomDay){
if(da<=day){
count++;
if(count==k){
bouquets++;
count=0;}
}else{
count=0;}
return bloomDay>=m;
}
}


class Solution {
    public int kthSmallest(int[][] mat, int k) {
    
        //Kth smallest element in a Matrix

        int n=mat.length;
        int low=mat[0][0];
        int high=mat[n-1][n-1];
        
            while(low<=high){
                int mid=low+(high-low)/2;
            
            if(counts(mat,k,mid,n)){
                high=mid-1;
            }else{
                low=mid+1;
            }
        }return low;}
        
    
    private boolean counts(int[][] mat,int k,int target,int n){
        int count=0;
        int row=n-1,col=0;
        while(row>=0 && col<=n-1){
            if(mat[row][col]<=target){
                count+=(row+1);
                col++;
            }else{
                row--;
            }
        }
        return count>=k;
    }
}

   



Aggressive Cows

class Solution {
    public int aggressiveCows(int[] arr, int k) {
        Arrays.sort(arr);
        // code here
        int n=arr.length;
        int low=1;
        int high=arr[n-1]-arr[0];
        int ans=0;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(can(arr,k,mid)){
                ans=mid; low=mid+1;
               
            }else{
                high=mid-1;
            }
        }return ans;
    }
    private boolean can(int[] arr,int k,int gap){
        int count=1;
        int last=arr[0];
        for(int i=1;i<arr.length;i++){
        if(arr[i]-last>=gap){
            count++;
            last=arr[i];
        }
        }
        return count>=k;
        
    }
    }


