        int[] ans=new int[n];
        Arrays.fill(ans,-1);
        Stack<Integer> s=new Stack<>();
        for(int i=2*n-1;i>=0;i--){
            int num=nums[i%n];
            while(!s.isEmpty() && s.peek()<=num){
                s.pop();
