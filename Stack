class Solution {
    public ArrayList<Integer> nextLargerElement(int[] arr) {
        // code here
        int n=arr.length;
        ArrayList<Integer> ans=new ArrayList<>();
        for(int i=0;i<n;i++){
            ans.add(-1);
        }
        Stack<Integer> s=new Stack<>();
        for(int j=n-1;j>=0;j--){
            while(!s.isEmpty() && s.peek()<=arr[j]){
                s.pop();
            }if(!s.isEmpty()){
                ans.set(j,s.peek());
            }         s.push(arr[j]);
        }
        return ans;
    }
}
