1.//Maximum Subarray using Kadane's Algorithm

class Solution {
    public int maxSubArray(int[] nums) {
        int maxSum=nums[0];
        int current=nums[0];
        for(int i=1;i<nums.length;i++){
            current=Math.max(nums[i],current+nums[i]);
            maxSum=Math.max(maxSum,current);
        }
        return maxSum;
    }
}

2.Maximum product of subarray using Kadane's Algorithm
class Solution {
    public int maxProduct(int[] nums) {
        int maxs=nums[0];
        for(int i=0;i<nums.length;i++){
            int product=1;
            for(int j=i;j<nums.length;j++){
                product*=nums[j];
                maxs=Math.max(maxs,product);
            }
            
        }return maxs;
    }
}
Plus One problem that used carry propogation in cpus,big integer arthematic ,calculator app etc
class Solution {
    public int[] plusOne(int[] digits) {
        int n=digits.length;
        for(int i=n-1;i>=0;i--){
            if(digits[i]<9){digits[i]++; return digits;}  digits[i]=0;
        }
       
     
        int[] res=new int[digits.length+1];
        res[0]=1;
        return res;
    }
}

MISSING NUMBER IN ARRAY
class Solution {
    public int missingNumber(int[] nums) {
        long n=nums.length;
        long sum=n*(n+1)/2;
        long ArrayS=0;
        for(int ele:nums){
            ArrayS+=ele;
        }
        return (int)(sum-ArrayS);
    }
}
